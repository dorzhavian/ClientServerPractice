# If mvn is available, use it directly
if command -v mvn > /dev/null 2>&1; then
  exec mvn "$@"
fi

# Otherwise attempt to use the wrapper jar
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$WRAPPER_JAR" ]; then
  exec java -jar "$WRAPPER_JAR" "$@"
fi

echo "ERROR: mvn not found and maven-wrapper.jar not available."
echo "Please install Maven: https://maven.apache.org/install.html"
exit 1
